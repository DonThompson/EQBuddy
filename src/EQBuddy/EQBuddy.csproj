<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms rides along for exactly one thing: NotifyIcon, the tray icon
         (#114 follow-up — a hidden widget must stay findable somewhere). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EQBuddy</AssemblyName>
    <RootNamespace>EQBuddy</RootNamespace>
    <!-- Version comes from Directory.Build.props (repo root) — single-sourced with the
         Avalonia app since issue #30. -->

    <!-- Do NOT enable InvariantGlobalization: WPF binding culture lookup
         (XmlLanguage.GetSpecificCulture) throws under it. -->
    <ApplicationIcon>Assets\EQBuddy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQBuddy.Companion\EQBuddy.Companion.csproj" />
    <ProjectReference Include="..\EQBuddy.Core\EQBuddy.Core.csproj" />
    <ProjectReference Include="..\EQBuddy.UI.Shared\EQBuddy.UI.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\tutorial\*.png" />
    <!-- The app font for Wine, where no Segoe font exists and DirectWrite reads
         only the primary font — see WineFonts.cs; rebuilt by scripts/build-icon-font.py. -->
    <Resource Include="Fonts\EQBuddySans.ttf" />
  </ItemGroup>

  <!-- WinForms' implicit global usings would make Application/Brush/Point ambiguous
       across every WPF file; TrayIcon.cs fully qualifies instead. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
