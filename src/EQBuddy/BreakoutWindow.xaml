<Window x:Class="EQBuddy.BreakoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="272" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" Padding="9,6,9,8"
            MouseLeftButtonDown="OnDrag">
        <StackPanel>
            <Grid Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontSize="12.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="1" x:Name="ScopeBorder" CornerRadius="9" BorderThickness="1"
                        Margin="6,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ScopeFight" Text="Fight" FontSize="10" Padding="7,1"
                                   Cursor="Hand" MouseLeftButtonDown="OnScopeFight"/>
                        <TextBlock x:Name="ScopeSession" Text="Session" FontSize="10" Padding="7,1"
                                   Cursor="Hand" MouseLeftButtonDown="OnScopeSession"/>
                    </StackPanel>
                </Border>
                <TextBlock Grid.Column="2" Text="✕" FontSize="11" VerticalAlignment="Center"
                           Cursor="Hand" Padding="2,0" MouseLeftButtonDown="OnDismiss"
                           ToolTip="Hide until the widget is next minimized"/>
            </Grid>
            <TextBlock x:Name="SubText" FontSize="10.5" Margin="1,0,0,5"
                       TextTrimming="CharacterEllipsis"/>
            <ItemsControl x:Name="Rows"/>
            <TextBlock x:Name="EmptyText" FontSize="11" Margin="1,1,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
