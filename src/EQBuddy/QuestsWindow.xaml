<Window x:Class="EQBuddy.QuestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EQBuddy Quest Tracker" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="530" WindowStartupLocation="Manual">
    <!-- Same chrome family as Spawns: the body scrolls, the title row stays reachable.
         Cards are built in code (BuildCards) — one per quest that overlaps the ledger. -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="10"
            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,6">
            <TextBlock x:Name="TitleText" Text="🗺 Quest Tracker" FontWeight="Bold" FontSize="14"
                       Foreground="{DynamicResource AccentBrush}"/>
            <Button Style="{StaticResource IconButton}" Content="&#x2715;" ToolTip="Close"
                    HorizontalAlignment="Right" Click="OnClose"/>
        </Grid>

        <!-- "I already have this" entry: item name + count, suggestions from the quest
             catalog so the name lands exactly as the wiki spells it. -->
        <StackPanel Grid.Row="1" Margin="16,0,16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AddItemBox" Grid.Column="0" Style="{StaticResource InputBox}"
                         TextChanged="OnAddItemTyped" KeyDown="OnAddItemKey"
                         ToolTip="Item you already have in inventory (from before EQBuddy could see it)"/>
                <TextBox x:Name="AddQtyBox" Grid.Column="1" Style="{StaticResource InputBox}" Text="1"
                         Margin="6,0,0,0" HorizontalContentAlignment="Center"
                         ToolTip="How many"/>
                <Button x:Name="AddBtn" Grid.Column="2" Content="+ I have this"
                        Style="{StaticResource ActionButton}" Margin="6,0,0,0" Click="OnAddItem"/>
            </Grid>
            <ListBox x:Name="SuggestList" MaxHeight="120" FontSize="12" Visibility="Collapsed"
                     Background="{DynamicResource ComboBoxBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     MouseUp="OnSuggestPicked"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FilterBox" Grid.Column="0" Style="{StaticResource InputBox}" MinWidth="110"
                         TextChanged="OnFilterChanged"
                         ToolTip="Search the whole catalog — quest names, turn-in items, rewards, quest givers, zones. Search ignores the class/era/state filters. Pin 📌 a result to track it."/>
                <ComboBox x:Name="EraCombo" Grid.Column="1" Width="104" FontSize="11"
                          Margin="6,0,0,0" SelectionChanged="OnEraChanged"
                          ToolTip="Hide quests from later eras than the world has (unmarked quests always show)"/>
                <!-- State filter (Reddit ask, 2026-08-11): every tab and search can
                     narrow to open / ready / completed. -->
                <ComboBox x:Name="StateCombo" Grid.Column="2" Width="86" FontSize="11"
                          Margin="6,0,0,0" SelectionChanged="OnStateChanged"
                          ToolTip="Any state · open (not yet completed) · ready (turn-ins in hand) · done (marked completed)"/>
                <!-- Multiclass filter (Legends: up to 3 active classes): a checkbox
                     popup, selection remembered per character. -->
                <Button x:Name="ClassBtn" Grid.Column="3" Content="Any class"
                        Style="{StaticResource ActionButton}" FontSize="11" Padding="8,2"
                        Margin="6,0,0,0" Click="OnClassBtn"
                        ToolTip="Pick your class(es) — quests any of them can do stay visible"/>
                <Popup x:Name="ClassPopup" PlacementTarget="{Binding ElementName=ClassBtn}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource PopupBrush}" CornerRadius="6"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="10,8">
                        <StackPanel x:Name="ClassChecks"/>
                    </Border>
                </Popup>
                <!-- mine = your items + 📌 pins · zone = doable where you're standing ·
                     all = the whole catalog -->
                <Border Grid.Column="4" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Margin="6,0,0,0"
                        VerticalAlignment="Center" Padding="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ModeMine" Text="mine" Tag="mine" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="Quests matching your items and pins"/>
                        <TextBlock x:Name="ModeZone" Text="zone" Tag="zone" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="Everything you can work on in the zone you're in"/>
                        <TextBlock x:Name="ModeHeld" Text="held" Tag="held" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="Quests you could turn in with what your bags already hold — from the game's /outputfile inventory dump. In game, type /outputfile inventory, and this tab reads the file the game writes."/>
                        <TextBlock x:Name="ModeDone" Text="done" Tag="done" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="Quests you've marked completed — every card has a ✓ done control, so returning players can check off history"/>
                        <TextBlock x:Name="ModeAll" Text="all" Tag="all" FontSize="10.5"
                                   Padding="7,1" Cursor="Hand" MouseLeftButtonDown="OnModeClick"
                                   ToolTip="The whole quest catalog"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <ScrollViewer x:Name="BodyScroll" Grid.Row="2" Margin="10,2,4,0"
                      VerticalScrollBarVisibility="Auto" Padding="6,0">
            <StackPanel x:Name="QuestsPanel" Margin="0,0,6,0"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="16,8,16,14">
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap"
                       Text="Counts what you loot, minus what the log sees leave (sales, merges, destroys), plus what you add above. Hand-ins aren't in the log — click ✔ ready when you turn in, or right-click an item row to clear it. Click a quest name for the full wiki walkthrough."/>
            <!-- The accuracy contract, said plainly (David, 2026-08-11): we mirror the
                 wiki, we're exactly as right as it is, and the door to fixing BOTH
                 swings from here. -->
            <TextBlock Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Every quest here mirrors eqlwiki.com — verified item-for-item against it, so EQBuddy is exactly as accurate as the wiki is today. Spot something wrong? ⚑ on the card tells us; fixing the wiki page itself fixes it for everyone (the catalog re-harvests weekly). Your own discoveries flow back too: Drops by Creature marks wiki-unknown drops in red with a paste-ready page edit."/>
        </StackPanel>
      </Grid>
    </Border>
</Window>
