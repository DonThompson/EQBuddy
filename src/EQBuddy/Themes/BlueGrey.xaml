    <SolidColorBrush x:Key="ComboBoxBrush" Color="#FF242830"/>
    <SolidColorBrush x:Key="ToggleHighlightBrush" Color="#335C8AC2"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#405C8AC2"/>
