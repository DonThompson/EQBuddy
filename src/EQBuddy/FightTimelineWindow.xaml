<Window x:Class="EQBuddy.FightTimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EQBuddy"
        Title="EQBuddy fight timeline"
        Width="680" Height="440" MinWidth="420" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="CanResize" WindowStartupLocation="Manual">
    <Border x:Name="Chrome" CornerRadius="12" BorderThickness="1" Padding="12,8,12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="96"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header is the window's drag handle; the plot below owns its own drag (pan). -->
            <Grid MouseLeftButtonDown="OnDragWindow" Background="Transparent" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubTitle" FontSize="11" Margin="8,1,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="PeakText" FontSize="11" Margin="0,1,10,0"/>
                <TextBlock Grid.Column="2" Text="Fit" FontSize="11" Cursor="Hand" Padding="6,0"
                           MouseLeftButtonDown="OnFit" Foreground="{DynamicResource AccentBrush}"
                           ToolTip="Snap back to the whole fight (scroll to zoom, drag the plot to pan)"/>
                <TextBlock Grid.Column="3" Text="✕" FontSize="11" Cursor="Hand" Padding="4,0"
                           MouseLeftButtonDown="OnClose"/>
            </Grid>

            <local:DpsGraphPanel Grid.Row="1" x:Name="Graph" ClipToBounds="True" Margin="0,0,0,2"/>

            <TextBlock Grid.Row="2" x:Name="LegendText" FontSize="10" Margin="0,1,0,3"
                       TextTrimming="CharacterEllipsis"
                       Text="▮ hit — taller = harder · orange = critical · ▢ miss / resist (hover for the log's words) · Incoming = damage you took"/>

            <ScrollViewer Grid.Row="3" x:Name="LaneScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <local:LanesPanel x:Name="Lanes" ClipToBounds="True" VerticalAlignment="Top"/>
            </ScrollViewer>

            <Popup x:Name="MarkTip" Placement="Relative" PlacementTarget="{Binding ElementName=Lanes}"
                   AllowsTransparency="True" IsHitTestVisible="False">
                <Border x:Name="TipChrome" CornerRadius="6" BorderThickness="1" Padding="7,3">
                    <TextBlock x:Name="TipText" FontSize="11"/>
                </Border>
            </Popup>

            <Thumb Grid.Row="3" Width="14" Height="14"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Margin="0,0,-6,-6" DragDelta="OnGripDrag"
                   ToolTip="Drag to resize">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <TextBlock Text="⤡" FontSize="13" Opacity="0.75"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Background="Transparent" Padding="2,0,0,0"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
